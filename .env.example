# x402-paid-server-go Environment Configuration
# Copy this file to .env and fill in the values.
#
# This server uses the official x402 Go SDK
# (github.com/x402-foundation/x402/go) for all x402 protocol handling,
# so prices are expressed as USD strings (e.g. "$0.01") and networks
# are CAIP-2 identifiers (e.g. "eip155:84532"). The SDK resolves the
# actual asset (USDC on Base Sepolia, etc.) via the facilitator's
# /supported endpoint at startup.

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_ADDR=:8080
LOG_LEVEL=info
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# =============================================================================
# Facilitator Configuration
# =============================================================================
# x402 facilitator base URL. Default: https://x402.org/facilitator
FACILITATOR_BASE_URL=https://x402.org/facilitator
FACILITATOR_TIMEOUT=30s

# =============================================================================
# Payment Configuration (REQUIRED)
# =============================================================================
# CAIP-2 network identifier. Default: eip155:84532 (Base Sepolia).
# Other examples: eip155:8453 (Base mainnet), eip155:1 (Ethereum).
PAYMENT_NETWORK=eip155:84532

# Seller wallet address that receives payments (REQUIRED).
PAY_TO_ADDRESS=0xYourWalletAddressHere

# Maximum settlement timeout advertised on every 402 (default: 300s).
PAYMENT_MAX_TIMEOUT=300s

# =============================================================================
# Endpoint Pricing (USD strings resolved by SDK against facilitator)
# =============================================================================
PAID_HELLO_PRICE=$0.01
PAID_ECHO_PRICE=$0.005
