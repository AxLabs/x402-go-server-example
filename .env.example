# x402-go-server-example environment configuration.
# Copy this file to .env and fill in values.
#
# Payment options are loaded from PAYMENT_CONFIG_FILE (YAML) and map directly
# to x402 PaymentRequirements fields (scheme, network, asset, amount, payTo,
# maxTimeoutSeconds, extra).

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_ADDR=:8080
# Host port for docker compose (change if 8080 is already in use on the machine).
SERVER_HOST_PORT=8080
# Use debug for per-request source locations (slog) and paid-route x402 header traces (see RequestLogger).
LOG_LEVEL=info
# Paid routes block on facilitator verify/settle + chain receipts; defaults above
# ~15–30s can close the TCP connection mid-response → client sees "EOF".
READ_TIMEOUT=120s
WRITE_TIMEOUT=120s
REQUEST_TIMEOUT=120s
SHUTDOWN_TIMEOUT=30s

# =============================================================================
# CORS (browser clients, e.g. React app on another origin)
# =============================================================================
# Comma-separated origins. Leave empty to disable CORS.
# CORS_ALLOWED_ORIGINS=https://your-react-client.example.com

# =============================================================================
# Facilitator Configuration
# =============================================================================
# REQUIRED: x402 facilitator base URL (no default).
FACILITATOR_BASE_URL=https://your-facilitator.example.com
FACILITATOR_TIMEOUT=120s

# Coolify: facilitator stack Docker network (docker network ls | grep hg20).
# Required for docker compose so the server can resolve http://facilitator:8080.
# FACILITATOR_DOCKER_NETWORK=hg20xignraizz6za0lx0ydja

# =============================================================================
# Payment Configuration (REQUIRED)
# =============================================================================
# Relative or absolute path to YAML payment config.
# See payment-config.example.yaml for structure.
PAYMENT_CONFIG_FILE=./payment-config.example.yaml
