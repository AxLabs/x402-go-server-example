# x402-go-server-example Environment Configuration
# Copy this file to .env and fill in the values.
#
# This server uses the official x402 Go SDK (github.com/x402-foundation/x402/go) for all x402 protocol handling.
# Prices are expressed as USD strings (e.g. "$0.01") and network/payment details are configuration-driven.

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_ADDR=:8080
LOG_LEVEL=info
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# =============================================================================
# Active Network Profile: Base Sepolia (temporary default)
# =============================================================================
# Base Sepolia is the current default due to go-ethereum v1.16 dependency
# compatibility. Neo X Testnet will become the default once it supports v1.16.
NETWORK_NAME=base-sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org
PAYMENT_ASSET=USDC

# Optional compatibility override for CAIP-2 network.
# If unset, PAYMENT_NETWORK is derived as eip155:${CHAIN_ID}.
# PAYMENT_NETWORK=eip155:84532

# =============================================================================
# Prepared Network Profile: Neo X Testnet (intended primary)
# =============================================================================
# Neo X Testnet is the intended primary network for this example. It is
# temporarily inactive because Neo X currently supports go-ethereum v1.15
# while this project requires v1.16. Uncomment the block below (and comment
# out the Base Sepolia block above) to switch back once compatible.
#
# NETWORK_NAME=neo-x-testnet
# CHAIN_ID=12227332
# RPC_URL=https://neoxt4seed1.ngd.network
# EXPLORER_URL=https://xt4scan.ngd.network
# PAYMENT_ASSET=USDC
# PAYMENT_NETWORK=eip155:12227332

# =============================================================================
# Facilitator Configuration
# =============================================================================
# Set this to a facilitator that supports the selected network profile.
FACILITATOR_BASE_URL=https://x402.org/facilitator
FACILITATOR_TIMEOUT=30s

# =============================================================================
# Payment Configuration (REQUIRED)
# =============================================================================
# Seller wallet address that receives payments.
PAY_TO_ADDRESS=0xYourWalletAddressHere

# Maximum settlement timeout advertised on every 402.
PAYMENT_MAX_TIMEOUT=300s

# =============================================================================
# Endpoint Pricing (USD strings resolved by SDK against facilitator)
# =============================================================================
PAID_HELLO_PRICE=$0.01
PAID_ECHO_PRICE=$0.005
